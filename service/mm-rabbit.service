[Unit]
Description=GridWorks MarketMaker (publishes latest.price onto the bus)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mm
# Repo root as CWD so `.env` at the repo root resolves.
WorkingDirectory=/home/mm/gridworks-marketmaker
ExecStart=/home/mm/gridworks-marketmaker/.venv/bin/gwmm rabbit
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
