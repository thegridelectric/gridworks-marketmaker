# Copy to .env (gitignored) and fill in.
# Settings use the GWMM_ prefix; nested fields use the __ delimiter.

# Rabbit broker URL: amqp:// for non-TLS, amqps:// for TLS.
GWMM_RABBIT__URL=amqp://smqPublic:smqPublic@localhost:5672/d1__1
# Against a gated broker, the client cert the FIS issuance tool printed:
# GWMM_RABBIT__TLS__CA_CERT_PATH=/home/mm/.config/gridworks/certs/ca.crt
# GWMM_RABBIT__TLS__CERT_PATH=/home/mm/.config/gridworks/certs/mm.crt
# GWMM_RABBIT__TLS__PRIVATE_KEY_PATH=/home/mm/.config/gridworks/certs/mm.pem

# Routable service alias. MUST match the g.node.gt JSON identity file's
# Alias (GridworksActor enforces the binding at boot).
GWMM_SERVICE_ALIAS=d1.isone.me.versant.keene

# g.node.gt JSON identity file (sema `g.node.gt` type). Default is the XDG
# config path for the service name; the dev identity is in scripts/.
GWMM_G_NODE_PATH=scripts/dev-g.node.gt.json

# ISO-NE web services login (https://webservices.iso-ne.com).
GWMM_ISONE_USER=
GWMM_ISONE_API_PASS=

GWMM_LOG_LEVEL=INFO

# gnr's public read façade. The actor re-reads its alias by GNodeId before
# each reconnect, so a registry rename converges without a redeploy. Unset
# turns that off (a dev rung with no gnr); the actor says so at boot.
# GWMM_GNR_URL=https://gnr.electricity.works
